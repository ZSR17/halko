{
  "name": "@halko/server",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "node --import tsx src/main.ts",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "seed:history": "tsx --env-file-if-exists=.env src/scripts/seed-history.ts",
    "import:exercises": "tsx src/scripts/import-exercises.ts",
    "export:library": "tsx src/scripts/export-library.ts",
    "hash-password": "tsx src/scripts/hash-password.ts"
  },
  "dependencies": {
    "@halko/shared": "*",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
