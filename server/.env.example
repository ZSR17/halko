# Copy this file to env/halko.env on the server (chmod 600).
PORT=3000
DATA_DIR=/data
# Generated with: npm run hash-password -- "your password"
APP_PASSWORD_HASH=
# Proxies whose X-Forwarded-For header is accepted (the reverse proxy in front of the app)
TRUST_PROXY=127.0.0.1/32,172.16.0.0/12
LOG_LEVEL=info
# Video and GIF conversion (already in the Docker image)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
