{
  "name": "halko",
  "version": "1.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "test": "npm test -w server && npm test -w client",
    "typecheck": "tsc -p shared && tsc -p server && tsc -p client",
    "db:generate": "npm run db:generate -w server",
    "seed:history": "npm run seed:history -w server --",
    "import:exercises": "npm run import:exercises -w server",
    "hash-password": "npm run hash-password -w server --",
    "dev": "concurrently -k -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "build": "npm run build -w client",
    "release": "node scripts/release.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "concurrently": "^9.2.5",
    "typescript": "^7.0.2"
  }
}
